---
interface Props {
  size?: "sm" | "md" | "lg" | "xl";
}

const { size = "xl" } = Astro.props;

const sizeClasses = {
  sm: "max-w-4xl",
  md: "max-w-5xl",
  lg: "max-w-6xl",
  xl: "max-w-7xl",
};
---

<div
  class:list={[
    "mx-auto w-full px-4 sm:px-6 md:px-8 lg:px-12 2xl:px-0",
    sizeClasses[size],
  ]}
>
  <slot />
</div>
