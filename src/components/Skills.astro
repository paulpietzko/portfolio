---
import Container from "../layouts/Container.astro";
import SkillCard from "./SkillCard.astro";
import SubTitle from "./SubTitle.astro";
import fetchSkills from "../utils/FetchSkills";

const skills = await fetchSkills();
---

<section class="skills" id="stack" data-skills>
  <Container size="xl">
    <SubTitle
      index="02"
      title="My techstack"
      text="The tools I reach for first. Frameworks come and go — most of the work is the same two things underneath: shaping data, and getting it on screen fast."
      link="#stack"
    />

    <div class="skills__grid" data-reveal-group="70">
      {skills.map((skill) => <SkillCard {...skill} />)}
    </div>
  </Container>
</section>

<style>
  .skills {
    padding-block: clamp(4rem, 9vh, 7rem);
  }

  /* Always three columns at desktop, never four */
  .skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  @media (min-width: 640px) {
    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .skills__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { register } from "../scripts/motion";

  register(() => {
    const section = document.querySelector<HTMLElement>("[data-skills]");
    if (!section) return;

    // One listener on the grid rather than one per card
    const onMove = (event: PointerEvent) => {
      const card = (event.target as HTMLElement)?.closest<HTMLElement>(
        "[data-spotlight]",
      );
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${event.clientX - rect.left}px`);
      card.style.setProperty("--my", `${event.clientY - rect.top}px`);
    };

    section.addEventListener("pointermove", onMove);
    return () => section.removeEventListener("pointermove", onMove);
  });
</script>
