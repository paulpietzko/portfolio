---
import skillsData from "../data/SkillsData.json";
import Container from "../layouts/Container.astro";
import SkillCard from "./SkillCard.astro";
import SubTitle from "./SubTitle.astro";

interface SkillType {
  name: string;
  description: string;
  imageUrl: string;
  bgColor: string;
  link: string;
}

const skills = skillsData as SkillType[];
---

<section class="skills" id="stack" data-skills>
  <Container size="xl">
    <SubTitle
      index="02"
      title="My techstack"
      text="The tools I reach for first. Frameworks come and go — most of this is really just TypeScript and C# wearing different hats."
      link="#stack"
    />

    <div class="skills__grid" data-reveal-group="70">
      {skills.map((skill) => <SkillCard {...skill} />)}
    </div>
  </Container>
</section>

<style>
  .skills {
    padding-block: clamp(4rem, 9vh, 7rem);
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
</style>

<script>
  import { register } from "../scripts/motion";

  register(() => {
    const section = document.querySelector<HTMLElement>("[data-skills]");
    if (!section) return;

    // One listener on the grid rather than one per card
    const onMove = (event: PointerEvent) => {
      const card = (event.target as HTMLElement)?.closest<HTMLElement>(
        "[data-spotlight]",
      );
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${event.clientX - rect.left}px`);
      card.style.setProperty("--my", `${event.clientY - rect.top}px`);
    };

    section.addEventListener("pointermove", onMove);
    return () => section.removeEventListener("pointermove", onMove);
  });
</script>
