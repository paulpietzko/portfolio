---
/**
 * The last year of contributions as a landscape behind the "Receipts"
 * section: no axes, no card, just the shape of the year rising out of the
 * bottom of the page. Plain server-rendered SVG, so it paints on first frame.
 */
interface Props {
  data: number[];
}

const { data } = Astro.props;

const W = 1440;
const H = 420;
// Headroom above the peak so its label never touches the top fade.
const TOP = 150;

const max = Math.max(...data, 1);
const peakIndex = data.indexOf(max);

// The first and last month sit inside the side fades, not under them, so
// December and the current month stay readable; the line runs on flat to the
// edges from there.
const INSET = W * 0.08;
const x = (i: number) => INSET + (i / (data.length - 1 || 1)) * (W - INSET * 2);
// Zero sits above the bottom edge, so quiet months (and the half-stroke of a
// line at zero) aren't clipped, and the month labels get their own strip.
const BOTTOM = 72;
const y = (v: number) => H - BOTTOM - (v / max) * (H - TOP - BOTTOM);

const points = data.map((v, i) => [x(i), y(v)] as const);

/** Catmull-Rom → cubic bézier, so the line curves without overshooting. */
const smoothPath = (pts: readonly (readonly [number, number])[]) => {
  if (pts.length < 2) return "";
  let d = `M ${pts[0][0]} ${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
  }
  return d;
};

const curve = smoothPath(points);
const first = points[0];
const last = points[points.length - 1];
const line = first && last
  ? `M 0 ${first[1]} L ${curve.slice(2)} L ${W} ${last[1]}`
  : "";
const area = `${line} L ${W} ${H} L 0 ${H} Z`;

const months = Array.from({ length: data.length }, (_, i) => {
  const d = new Date();
  d.setDate(1);
  d.setMonth(d.getMonth() - (data.length - 1 - i));
  return d.toLocaleString("en-US", { month: "short" });
});

// Percentages, so the HTML labels line up with the stretched SVG.
const pctX = (i: number) => (x(i) / W) * 100;
const pctY = (v: number) => (y(v) / H) * 100;
---

<figure
  class="ridge"
  aria-label={`Contributions over the last ${data.length} months, peaking at ${max} in ${months[peakIndex]}.`}
>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="ridge-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-accent-soft)" stop-opacity="0.22" />
        <stop offset="70%" stop-color="var(--color-accent-soft)" stop-opacity="0.04" />
        <stop offset="100%" stop-color="var(--color-accent-soft)" stop-opacity="0" />
      </linearGradient>
      <!-- Vertical strokes every few px read as a scanline texture -->
      <pattern id="ridge-lines" width="6" height={H} patternUnits="userSpaceOnUse">
        <line x1="0.5" x2="0.5" y1="0" y2={H} />
      </pattern>
      <clipPath id="ridge-clip">
        <path d={area} />
      </clipPath>
    </defs>

    <path class="ridge__area" d={area} fill="url(#ridge-fill)" />
    <rect
      class="ridge__lines"
      width={W}
      height={H}
      fill="url(#ridge-lines)"
      clip-path="url(#ridge-clip)"
    />
    <path class="ridge__glow" d={line} />
    <path class="ridge__line" d={line} />
  </svg>

  <!-- Labels live in HTML so the stretched SVG doesn't distort the text -->
  <span
    class="ridge__peak"
    style={`left:${pctX(peakIndex)}%; top:${pctY(max)}%`}
  >
    <span class="ridge__dot"></span>
    <span class="ridge__peak-label">{max} · {months[peakIndex]}</span>
  </span>

  <ol class="ridge__months">
    {months.map((month, i) => <li style={`left:${pctX(i)}%`}>{month}</li>)}
  </ol>
</figure>

<style>
  .ridge {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .ridge svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ridge__area {
    opacity: 0;
    transition: opacity 1400ms var(--ease-out-quart) 500ms;
  }

  .ridge__lines line {
    stroke: var(--color-accent-soft);
    stroke-width: 1;
    opacity: 0.12;
    vector-effect: non-scaling-stroke;
  }

  .ridge__lines {
    opacity: 0;
    transition: opacity 1400ms var(--ease-out-quart) 700ms;
  }

  .ridge__glow {
    fill: none;
    stroke: var(--color-accent-soft);
    stroke-width: 10;
    opacity: 0;
    filter: blur(10px);
    vector-effect: non-scaling-stroke;
    transition: opacity 1400ms var(--ease-out-quart) 900ms;
  }

  .ridge__line {
    fill: none;
    stroke: var(--color-accent-soft);
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    /* Revealed left to right with a clip rather than a stroke dash: dash
       maths breaks on a stretched (`preserveAspectRatio="none"`) path with a
       non-scaling stroke, which stopped the line short of the last month. */
    clip-path: inset(0 100% 0 0);
  }

  .ridge__peak {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    translate: -0.3rem -50%;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out-quart) 1300ms;
  }

  .ridge__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    box-shadow: 0 0 0 0.35rem rgb(10 207 131 / 0.15);
  }

  .ridge__peak-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent-soft);
    white-space: nowrap;
  }

  .ridge__months {
    position: absolute;
    inset: auto 0 1rem;
    height: 1em;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    opacity: 0.6;
  }

  /* Each label sits under its own data point */
  .ridge__months li {
    position: absolute;
    translate: -50% 0;
  }

  /* Phones: twelve labels don't fit, every other one does */
  @media (max-width: 767px) {
    .ridge__months li:nth-child(even) {
      visibility: hidden;
    }
  }

  /* `.is-in` is added by the shared reveal observer on the wrapper */
  :global(.is-in) > .ridge .ridge__line {
    animation: draw 2200ms var(--ease-out-quart) forwards;
  }

  :global(.is-in) > .ridge .ridge__area,
  :global(.is-in) > .ridge .ridge__lines,
  :global(.is-in) > .ridge .ridge__glow {
    opacity: 1;
  }

  :global(.is-in) > .ridge .ridge__glow {
    opacity: 0.35;
  }

  :global(.is-in) > .ridge .ridge__peak {
    opacity: 1;
  }

  /* Without the reveal engine, show the finished state */
  :global(html:not(.js)) .ridge__line {
    clip-path: none;
  }

  :global(html:not(.js)) .ridge__area,
  :global(html:not(.js)) .ridge__lines,
  :global(html:not(.js)) .ridge__peak {
    opacity: 1;
  }

  @keyframes draw {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ridge__line {
      clip-path: none;
      animation: none !important;
    }
    .ridge__area,
    .ridge__lines,
    .ridge__glow,
    .ridge__peak {
      transition: none;
    }
  }
</style>
