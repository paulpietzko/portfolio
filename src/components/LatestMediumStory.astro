---
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";

type Story = {
  title: string;
  paragraphs: string[];
  date: Date | null;
  link: string;
  truncated: boolean;
};

const MAX_CHARS = 1400;
const FEED =
  "https://api.rss2json.com/v1/api.json?rss_url=https://medium.com/feed/@paul.pietzko";

// Medium's RSS body is HTML. Every block-level close becomes a break,
// otherwise captions run straight into the following paragraph.
const BLOCK_END =
  /<\/(p|div|h[1-6]|li|ul|ol|figure|figcaption|blockquote|pre|section)>/gi;

const stripHtml = (html: string) =>
  html
    .replace(BLOCK_END, "\n\n")
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/?[^>]+(>|$)/g, "")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/[ \t]+/g, " ")
    .trim();

// Articles often embed ASCII trees and code blocks, which read as noise once
// the markup is gone.
const isProse = (paragraph: string) => {
  const art = (paragraph.match(/[│├└─┌┐┘┬┴┼|+\\/_]/g) ?? []).length;
  return art / paragraph.length < 0.06;
};

const fetchStory = async (): Promise<Story | null> => {
  try {
    const res = await fetch(FEED);
    if (!res.ok) return null;
    const { items } = await res.json();
    const first = items?.[0];
    if (!first) return null;

    const body = stripHtml(first.description ?? "");
    return {
      title: first.title,
      link: first.link,
      date: first.pubDate ? new Date(first.pubDate) : null,
      truncated: body.length > MAX_CHARS,
      paragraphs: body
        .slice(0, MAX_CHARS)
        .split(/\n\s*\n/)
        .map((p) => p.trim())
        .filter((p) => p.length > 0 && isProse(p)),
    };
  } catch {
    // The feed is a third-party service — never let it fail the build
    return null;
  }
};

const story = await fetchStory();

// Words are split here rather than in the browser, so the illumination is
// driven by a single CSS variable instead of per-word DOM surgery.
let cursor = 0;
const lines = (story?.paragraphs ?? []).map((paragraph) =>
  paragraph.split(/\s+/).map((word) => ({ word, index: cursor++ })),
);
const wordCount = Math.max(cursor, 1);
---

{
  story && (
    <section class="story" id="writing" data-story>
      <Container size="xl">
        <div class="story__head">
          <SubTitle
            index="05"
            title="Latest story"
            text={[
              story.title,
              story.date?.toLocaleDateString("en-US", {
                month: "short",
                day: "2-digit",
                year: "numeric",
              }),
            ]
              .filter(Boolean)
              .join(" · ")}
            link={story.link}
          />
        </div>

        <div
          class="story__body"
          style={`--n:${wordCount}`}
          data-story-body
        >
          {lines.map((words) => (
            <p>
              {words.map(({ word, index }) => (
                <>
                  <span class="story__word" style={`--i:${index}`}>
                    {word}
                  </span>{" "}
                </>
              ))}
            </p>
          ))}
          {story.truncated && <p class="story__more">…</p>}
        </div>

        <a class="story__link" href={story.link} target="_blank" rel="noopener noreferrer">
          <span>Read the whole thing on Medium</span>
          <span class="story__link-arrow" aria-hidden="true">↗</span>
        </a>
      </Container>
    </section>
  )
}

<style>
  .story {
    padding-block: clamp(4rem, 9vh, 7rem);
  }

  .story__head {
    position: sticky;
    top: 0;
    z-index: 5;
    padding-top: clamp(4rem, 10vh, 7rem);
    /* Solid behind the heading itself, then a short fade so the running text
       dissolves under it instead of colliding with it */
    padding-bottom: 5rem;
    background: linear-gradient(
      to bottom,
      var(--color-dark-100) 0 calc(100% - 5rem),
      transparent 100%
    );
  }

  .story__head :global(.section-head) {
    margin-bottom: 0;
  }

  .story__body {
    font-size: clamp(1.15rem, 2.6vw, 2rem);
    line-height: 1.55;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .story__body p + p {
    margin-top: 1.2em;
  }

  /*
   * The whole illumination is one custom property. --p sweeps 0→1 as the
   * block passes the viewport, and each word compares its own index against
   * the moving edge. No per-word JavaScript, no layout reads.
   */
  .story__word {
    display: inline-block;
    color: #fff;
    /* Low floor so unlit text sits well back and the lit edge reads clearly;
       the steep multiplier keeps the sweep quick. */
    opacity: clamp(0.1, calc((var(--p, 1) * var(--n) - var(--i)) * 0.9), 1);
  }

  .story__more {
    color: var(--fg-3);
  }

  .story__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.95rem;
    color: var(--fg-1);
    transition: border-color var(--dur-mid) var(--ease-out-quart);
  }

  .story__link:hover {
    border-color: var(--color-accent);
  }

  .story__link-arrow {
    color: var(--color-accent);
    transition: translate var(--dur-mid) var(--ease-out-expo);
  }

  .story__link:hover .story__link-arrow {
    translate: 3px -3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .story__word {
      opacity: 1;
    }
  }
</style>

<script>
  import { register, trackRect, range, prefersReducedMotion } from "../scripts/motion";

  register(() => {
    const body = document.querySelector<HTMLElement>("[data-story-body]");
    if (!body || prefersReducedMotion()) return;

    body.style.setProperty("--p", "0");

    return trackRect(body, (rect, vh) => {
      // Fully lit once the block's bottom reaches the lower third, so the
      // text is readable while it is still on screen rather than only after
      // most of it has scrolled past.
      const p = range(rect.top, vh * 0.95, vh * 0.72 - rect.height);
      body.style.setProperty("--p", p.toFixed(4));
    });
  });
</script>
