---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";
import eventsData from "../data/EventsData.json";

const events = [...eventsData].sort((a, b) => {
  const ta = Number(new Date(a?.date)) || 0;
  const tb = Number(new Date(b?.date)) || 0;
  return tb - ta; // newest first
});

/**
 * Event photos live in src/assets so Astro can resize and re-encode them at
 * build time. EventsData.json still refers to them as /images/events/... —
 * this maps that path onto the bundled asset.
 */
const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/events/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const resolve = (url: string): ImageMetadata | null => {
  const key = `/src/assets${url.replace(/^\/images/, "")}`;
  const found = assets[key];
  if (!found) console.warn(`[events] no image bundled for ${url}`);
  return found?.default ?? null;
};

const cards = events
  .map((event) => ({
    event,
    image: resolve(event.imageUrl),
    hover: event.hoverImageUrl ? resolve(event.hoverImageUrl) : null,
  }))
  .filter((card) => card.image !== null);

const formatDate = (date: string) =>
  date
    ? new Date(date).toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
      })
    : "";
---

<section class="events" id="events">
  <Container size="xl">
    <SubTitle
      index="04"
      title="Places I turned up"
      text="Conferences, ceremonies, a mud run and eighteen weeks of military service. Scroll on — the gallery moves with you."
      link="#events"
    />
  </Container>

  <div class="gallery" data-gallery>
    <div class="gallery__stage">
      <div class="gallery__rail" data-rail>
        {
          cards.map(({ event, image, hover }) => (
            <a
              class="card"
              href={event.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="card__media">
                <Image
                  src={image!}
                  alt={event.name}
                  width={640}
                  widths={[320, 640]}
                  sizes="20rem"
                  format="webp"
                  quality={68}
                  loading="lazy"
                  decoding="async"
                />
                {hover && (
                  <Image
                    class="card__media-hover"
                    src={hover}
                    alt=""
                    aria-hidden="true"
                    width={640}
                    widths={[320, 640]}
                    sizes="20rem"
                    format="webp"
                    quality={68}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>

              <div class="card__body">
                <span class="card__date eyebrow">{formatDate(event.date)}</span>
                <h3 class="card__title">{event.name}</h3>
                {event.description && (
                  <p class="card__text">{event.description}</p>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .events {
    padding-block: clamp(4rem, 9vh, 7rem) clamp(5rem, 13vh, 9rem);
  }

  /* --- pinned scroll ---------------------------------------------------- */

  .gallery {
    /* Vertical scroll distance equals horizontal travel, so the rail moves
       exactly as fast as the page does. --travel is measured in JS. */
    height: calc(100svh + var(--travel, 0px));
  }

  .gallery__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /*
   * Column-wrap masonry: cards are a fixed width with their natural height,
   * and the fixed rail height makes them wrap into ragged columns. Nothing
   * is cropped, so every photo keeps its own orientation.
   */
  .gallery__rail {
    display: flex;
    flex-flow: column wrap;
    align-content: flex-start;
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
    height: min(74svh, 42rem);
    padding-inline: clamp(1rem, 5vw, 5rem);
    transform: translate3d(calc(var(--p, 0) * var(--travel, 0px) * -1), 0, 0);
    will-change: transform;
  }

  /* --- cards ------------------------------------------------------------ */

  .card {
    position: relative;
    display: block;
    width: 20rem;
    flex: none;
    overflow: hidden;
    border-radius: 0.9rem;
    background: var(--color-dark-200);
    isolation: isolate;
  }

  .card__media {
    position: relative;
    display: block;
  }

  .card__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition:
      scale var(--dur-xslow) var(--ease-out-expo),
      opacity var(--dur-slow) var(--ease-out-quart);
  }

  .card__media :global(.card__media-hover) {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .card:hover .card__media :global(img) {
    scale: 1.06;
  }

  .card:hover .card__media :global(.card__media-hover) {
    opacity: 1;
  }

  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.85) 0%,
      rgb(0 0 0 / 0.45) 38%,
      rgb(0 0 0 / 0) 72%
    );
    z-index: 1;
    pointer-events: none;
  }

  .card__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: clamp(1rem, 1.6vw, 1.5rem);
    color: #fff;
  }

  .card__date {
    display: block;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .card__title {
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card__text {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height var(--dur-slow) var(--ease-out-expo),
      opacity var(--dur-mid) var(--ease-out-quart);
  }

  .card:hover .card__text,
  .card:focus-visible .card__text {
    max-height: 5rem;
    opacity: 1;
  }

  /* --- no pinning on small screens or with reduced motion --------------- */

  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .gallery {
      height: auto;
    }

    .gallery__stage {
      position: static;
      height: auto;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .gallery__stage::-webkit-scrollbar {
      display: none;
    }

    .gallery__rail {
      transform: none;
      height: 30rem;
      will-change: auto;
    }

    .card {
      width: 15rem;
    }

    .card__text {
      max-height: 5rem;
      opacity: 1;
    }
  }
</style>

<script>
  import { register, trackProgress, prefersReducedMotion } from "../scripts/motion";

  register(() => {
    const gallery = document.querySelector<HTMLElement>("[data-gallery]");
    const rail = gallery?.querySelector<HTMLElement>("[data-rail]");
    const stage = gallery?.querySelector<HTMLElement>(".gallery__stage");
    if (!gallery || !rail || !stage) return;

    const pinned = () =>
      window.matchMedia("(min-width: 768px)").matches && !prefersReducedMotion();

    const measure = () => {
      if (!pinned()) {
        gallery.style.removeProperty("--travel");
        return;
      }
      // Column-wrap flex containers don't widen to fit their columns, so the
      // real extent has to come from scrollWidth rather than offsetWidth.
      const travel = Math.max(0, rail.scrollWidth - stage.clientWidth);
      gallery.style.setProperty("--travel", `${Math.round(travel)}px`);
    };

    measure();
    window.addEventListener("resize", measure);

    // Card heights are intrinsic, so the columns only settle once the images
    // have their boxes — Astro emits width/height, but re-measure anyway.
    const images = [...rail.querySelectorAll("img")];
    const pending = images.filter((img) => !img.complete);
    let left = pending.length;
    for (const img of pending) {
      const done = () => {
        if (--left === 0) measure();
      };
      img.addEventListener("load", done, { once: true });
      img.addEventListener("error", done, { once: true });
    }

    const stop = trackProgress(gallery, "pin", (p) =>
      gallery.style.setProperty("--p", p.toFixed(4)),
    );

    return () => {
      stop();
      window.removeEventListener("resize", measure);
    };
  });
</script>
