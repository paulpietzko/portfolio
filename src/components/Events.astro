---
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";
import eventsData from "../data/EventsData.json";
import { aspectRatio } from "../utils/ImageSize";

const events = [...eventsData].sort((a, b) => {
  const ta = Number(new Date(a?.date)) || 0;
  const tb = Number(new Date(b?.date)) || 0;
  return tb - ta; // newest first
});

/**
 * Card heights come from the images themselves, not a fixed pattern: each
 * photo's real pixel ratio picks a row span whose slot has roughly the same
 * shape, so a panorama gets a wide card and a portrait gets a tall one and
 * `object-fit: cover` barely has to crop anything.
 */
const ROWS = 6;

const spanFor = (imageUrl: string) => {
  const ratio = aspectRatio(imageUrl);
  if (ratio === null) return 3; // unknown file — take the middle option
  if (ratio >= 2.0) return 2; // panorama
  if (ratio >= 1.35) return 3; // landscape
  if (ratio >= 0.95) return 4; // square-ish
  return 6; // portrait
};

type Cell = { event: (typeof events)[number]; span: number; start?: number };

const remaining = events.map((event) => ({ event, span: spanFor(event.imageUrl) }));
const columns: Cell[][] = [];

// First-fit with look-ahead: keeps roughly chronological order while still
// filling each column, instead of stranding a lone card in the last one.
while (remaining.length) {
  const column: Cell[] = [];
  let used = 0;

  for (;;) {
    const next = remaining.findIndex((cell) => used + cell.span <= ROWS);
    if (next === -1) break;
    const [cell] = remaining.splice(next, 1);
    column.push(cell);
    used += cell.span;
  }

  // A column that didn't fill sits centred rather than pinned to the top
  if (used < ROWS && column.length) {
    let row = Math.floor((ROWS - used) / 2) + 1;
    for (const cell of column) {
      cell.start = row;
      row += cell.span;
    }
  }

  columns.push(column);
}

const formatDate = (date: string) =>
  date
    ? new Date(date).toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
      })
    : "";
---

<section class="events" id="events">
  <Container size="xl">
    <SubTitle
      index="04"
      title="Places I turned up"
      text="Conferences, ceremonies, a mud run and eighteen weeks of military service. Scroll on — the gallery moves with you."
      link="#events"
    />
  </Container>

  <div class="gallery" data-gallery>
    <div class="gallery__stage">
      <div class="gallery__rail" data-rail>
        {
          columns.map((cells) => (
            <div class="gallery__col">
              {cells.map(({ event, span, start }) => (
                <a
                  class="card"
                  style={`--span:${span};${start ? `--start:${start};` : ""}`}
                  href={event.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="card__media">
                    <img
                      src={event.imageUrl}
                      alt={event.name}
                      loading="lazy"
                      decoding="async"
                    />
                    {event.hoverImageUrl && (
                      <img
                        class="card__media-hover"
                        src={event.hoverImageUrl}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </div>

                  <div class="card__body">
                    <span class="card__date eyebrow">
                      {formatDate(event.date)}
                    </span>
                    <h3 class="card__title">{event.name}</h3>
                    {event.description && (
                      <p class="card__text">{event.description}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .events {
    padding-block: clamp(4rem, 9vh, 7rem) clamp(5rem, 13vh, 9rem);
  }

  /* --- the scroll-driven track ----------------------------------------- */

  /* No pinning and no viewport-height band — the gallery is a normal block
     that happens to travel right-to-left as the page scrolls past it. */
  .gallery__stage {
    overflow: hidden;
  }

  .gallery__rail {
    display: flex;
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
    height: clamp(24rem, 62vh, 38rem);
    padding-inline: clamp(1rem, 5vw, 5rem);
    transform: translate3d(calc(var(--p, 0) * var(--travel, 0px) * -1), 0, 0);
    will-change: transform;
  }

  /* Explicit row units, so every card's height is exactly its span
     regardless of what else ended up in the column. */
  .gallery__col {
    display: grid;
    grid-template-rows: repeat(6, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
    flex: none;
    width: clamp(16rem, 28vw, 25rem);
    height: 100%;
  }

  /* --- cards ------------------------------------------------------------ */

  .card {
    position: relative;
    grid-row: var(--start, auto) / span var(--span, 3);
    display: block;
    overflow: hidden;
    border-radius: 0.9rem;
    background: var(--color-dark-200);
    isolation: isolate;
  }

  .card__media {
    position: absolute;
    inset: 0;
  }

  .card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Slight counter-drift gives the rail some depth as it travels */
    scale: 1.12;
    translate: calc(var(--p, 0) * 1.5rem) 0;
    transition:
      scale var(--dur-xslow) var(--ease-out-expo),
      opacity var(--dur-slow) var(--ease-out-quart);
  }

  .card__media-hover {
    opacity: 0;
  }

  .card:hover .card__media img {
    scale: 1.2;
  }

  .card:hover .card__media-hover {
    opacity: 1;
  }

  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.85) 0%,
      rgb(0 0 0 / 0.45) 38%,
      rgb(0 0 0 / 0) 72%
    );
    z-index: 1;
    transition: opacity var(--dur-slow) var(--ease-out-quart);
  }

  .card__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: clamp(1rem, 1.6vw, 1.5rem);
    color: #fff;
  }

  .card__date {
    display: block;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .card__title {
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card__text {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Held back until hover so the grid reads as images first */
    max-height: 0;
    opacity: 0;
    transition:
      max-height var(--dur-slow) var(--ease-out-expo),
      opacity var(--dur-mid) var(--ease-out-quart);
  }

  .card:hover .card__text,
  .card:focus-visible .card__text {
    max-height: 5rem;
    opacity: 1;
  }

  /* --- no pinning on small screens or with reduced motion --------------- */

  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .gallery__stage {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }

    .gallery__stage::-webkit-scrollbar {
      display: none;
    }

    .gallery__rail {
      transform: none;
      height: 30rem;
    }

    .gallery__col {
      scroll-snap-align: center;
      width: 15rem;
    }

    .card__media img {
      translate: none;
    }

    .card__text {
      max-height: 5rem;
      opacity: 1;
    }
  }
</style>

<script>
  import { register, trackProgress, prefersReducedMotion } from "../scripts/motion";

  register(() => {
    const gallery = document.querySelector<HTMLElement>("[data-gallery]");
    const rail = gallery?.querySelector<HTMLElement>("[data-rail]");
    const stage = gallery?.querySelector<HTMLElement>(".gallery__stage");
    if (!gallery || !rail || !stage) return;

    const pinned = () =>
      window.matchMedia("(min-width: 768px)").matches && !prefersReducedMotion();

    const measure = () => {
      if (!pinned()) {
        gallery.style.removeProperty("--travel");
        return;
      }
      const travel = Math.max(0, rail.scrollWidth - stage.clientWidth);
      gallery.style.setProperty("--travel", `${Math.round(travel)}px`);
    };

    measure();
    window.addEventListener("resize", measure);
    // Card images change the rail width once they land
    const imagesReady = Promise.all(
      [...rail.querySelectorAll("img")]
        .filter((img) => !img.complete)
        .map(
          (img) =>
            new Promise<void>((resolve) => {
              img.addEventListener("load", () => resolve(), { once: true });
              img.addEventListener("error", () => resolve(), { once: true });
            }),
        ),
    );
    imagesReady.then(measure);

    // The travel now happens while the gallery crosses the viewport. Using
    // the middle 70% of that window means the first and last cards are
    // actually readable rather than only reachable at the extremes.
    const stop = trackProgress(gallery, "cover", (p) => {
      const eased = Math.min(Math.max((p - 0.15) / 0.7, 0), 1);
      gallery.style.setProperty("--p", eased.toFixed(4));
    });

    return () => {
      stop();
      window.removeEventListener("resize", measure);
    };
  });
</script>
