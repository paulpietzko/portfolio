---
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";
import fetchEvents from "../utils/FetchEvents";
import {
  imagePlaceholder,
  imageSrc,
  imageSrcSet,
  type SanityImage,
} from "../utils/SanityImage";

const events = await fetchEvents();

// Cards are 25rem wide on desktop and 15rem on mobile, so these two candidates
// cover both at 1x and 2x.
const WIDTHS = [400, 800];

const srcset = (image: SanityImage) => imageSrcSet(image, WIDTHS);

// Anchored at midday: a plain YYYY-MM-DD parses as UTC midnight, which slips
// back a month in western timezones on the first of the month.
const parseDate = (date: string) => new Date(`${date}T12:00:00`);

const MONTH_YEAR = { month: "short", year: "numeric" } as const;

/** "21 Aug" — day first, so ranges read the same way the single dates do. */
const dayMonth = (date: Date) =>
  `${date.getDate()} ${date.toLocaleDateString("en-US", { month: "short" })}`;

/**
 * A single date reads "Aug 2026", as it always has. Days only appear when there
 * is a span worth showing, so a one-day event is never dressed up as a range —
 * and an end date that is missing, equal or (invalid data) earlier than the
 * start falls back to the plain month.
 */
const formatDate = (date: string, endDate?: string | null) => {
  if (!date) return "";

  const start = parseDate(date);
  if (!endDate || endDate <= date) {
    return start.toLocaleDateString("en-US", MONTH_YEAR);
  }

  const end = parseDate(endDate);
  const sameYear = start.getFullYear() === end.getFullYear();

  // 21–23 Aug 2026
  if (sameYear && start.getMonth() === end.getMonth()) {
    return `${start.getDate()}–${end.getDate()} ${end.toLocaleDateString("en-US", MONTH_YEAR)}`;
  }

  // 28 Aug – 2 Sep 2026
  if (sameYear) {
    return `${dayMonth(start)} – ${dayMonth(end)} ${end.getFullYear()}`;
  }

  // 28 Dec 2025 – 2 Jan 2026
  return `${dayMonth(start)} ${start.getFullYear()} – ${dayMonth(end)} ${end.getFullYear()}`;
};
---

<section class="events" id="events">
  <Container size="xl">
    <SubTitle
      index="04"
      title="Places I turned up"
      text="Conferences, ceremonies, a mud run and eighteen weeks of military service. Scroll on — the gallery moves with you."
      link="#events"
    />
  </Container>

  <div class="gallery" data-gallery>
    <div class="gallery__stage">
      <div class="gallery__rail" data-rail>
        {
          events.map(({ name, link, description, date, endDate, image, hoverImage }) => {
            // A card without a link is still a card — an <a> without an href
            // would only look like one.
            const Card = link ? "a" : "div";
            const anchor = link
              ? { href: link, target: "_blank", rel: "noopener noreferrer" }
              : {};

            return (
              <Card class="card" {...anchor}>
                <div class="card__media">
                  <img
                    src={imageSrc(image, 800)}
                    srcset={srcset(image)}
                    sizes="(max-width: 767px) 15rem, 25rem"
                    width={image.asset.metadata.dimensions.width}
                    height={image.asset.metadata.dimensions.height}
                    alt={image.alt ?? name}
                    loading="lazy"
                    decoding="async"
                    style={imagePlaceholder(image)}
                  />
                  {hoverImage && (
                    <img
                      class="card__media-hover"
                      src={imageSrc(hoverImage, 800)}
                      srcset={srcset(hoverImage)}
                      sizes="(max-width: 767px) 15rem, 25rem"
                      width={hoverImage.asset.metadata.dimensions.width}
                      height={hoverImage.asset.metadata.dimensions.height}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>

                <div class="card__body">
                  <span class="card__date eyebrow">{formatDate(date, endDate)}</span>
                  <h3 class="card__title">{name}</h3>
                  {description && <p class="card__text">{description}</p>}
                </div>
              </Card>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .events {
    padding-block: clamp(4rem, 9vh, 7rem) clamp(5rem, 13vh, 9rem);
  }

  /* --- pinned scroll ---------------------------------------------------- */

  .gallery {
    /* Vertical scroll distance equals horizontal travel, so the rail moves
       exactly as fast as the page does. --travel is measured in JS. */
    height: calc(100svh + var(--travel, 0px));
  }

  .gallery__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /*
   * Column-wrap masonry: cards are a fixed width with their natural height,
   * and the fixed rail height makes them wrap into ragged columns. Nothing
   * is cropped, so every photo keeps its own orientation.
   */
  .gallery__rail {
    display: flex;
    flex-flow: column wrap;
    align-content: flex-start;
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
    /* Tall enough for the most extreme portrait card (~1.8x the card width)
       so nothing overflows the column. */
    height: min(84svh, 48rem);
    padding-inline: clamp(1rem, 5vw, 5rem);
    transform: translate3d(calc(var(--p, 0) * var(--travel, 0px) * -1), 0, 0);
    will-change: transform;
  }

  /* --- cards ------------------------------------------------------------ */

  .card {
    position: relative;
    display: block;
    /* Wider cards make the rail meaningfully wider than the viewport, which
       is what gives the pinned section something to scroll through. */
    width: 25rem;
    max-height: 100%;
    flex: none;
    overflow: hidden;
    border-radius: 0.9rem;
    background: var(--color-dark-200);
    isolation: isolate;
  }

  .card__media {
    position: relative;
    display: block;
  }

  .card__media img {
    display: block;
    width: 100%;
    height: auto;
    /* The LQIP set inline needs to fill the box it sits behind. */
    background-size: cover;
    background-position: center;
    transition:
      scale var(--dur-xslow) var(--ease-out-expo),
      opacity var(--dur-slow) var(--ease-out-quart);
  }

  .card__media .card__media-hover {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .card:hover .card__media img {
    scale: 1.06;
  }

  .card:hover .card__media .card__media-hover {
    opacity: 1;
  }

  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.85) 0%,
      rgb(0 0 0 / 0.45) 38%,
      rgb(0 0 0 / 0) 72%
    );
    z-index: 1;
    pointer-events: none;
  }

  .card__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: clamp(1rem, 1.6vw, 1.5rem);
    color: #fff;
  }

  .card__date {
    display: block;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .card__title {
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card__text {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height var(--dur-slow) var(--ease-out-expo),
      opacity var(--dur-mid) var(--ease-out-quart);
  }

  .card:hover .card__text,
  .card:focus-visible .card__text {
    max-height: 5rem;
    opacity: 1;
  }

  /* --- no pinning on small screens or with reduced motion --------------- */

  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .gallery {
      height: auto;
    }

    .gallery__stage {
      position: static;
      height: auto;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .gallery__stage::-webkit-scrollbar {
      display: none;
    }

    .gallery__rail {
      transform: none;
      height: 30rem;
      will-change: auto;
    }

    .card {
      width: 15rem;
    }

    .card__text {
      max-height: 5rem;
      opacity: 1;
    }
  }
</style>

<script>
  import { register, trackProgress, prefersReducedMotion } from "../scripts/motion";

  register(() => {
    const gallery = document.querySelector<HTMLElement>("[data-gallery]");
    const rail = gallery?.querySelector<HTMLElement>("[data-rail]");
    const stage = gallery?.querySelector<HTMLElement>(".gallery__stage");
    if (!gallery || !rail || !stage) return;

    const pinned = () =>
      window.matchMedia("(min-width: 768px)").matches && !prefersReducedMotion();

    const measure = () => {
      if (!pinned()) {
        gallery.style.removeProperty("--travel");
        return;
      }
      // Column-wrap flex containers don't widen to fit their columns, so the
      // real extent has to come from scrollWidth rather than offsetWidth.
      const travel = Math.max(0, rail.scrollWidth - stage.clientWidth);
      gallery.style.setProperty("--travel", `${Math.round(travel)}px`);
    };

    measure();
    window.addEventListener("resize", measure);

    // Card heights are intrinsic, so the columns only settle once the images
    // have their boxes — the width/height attributes give them one up front,
    // but re-measure anyway.
    const images = [...rail.querySelectorAll("img")];
    const pending = images.filter((img) => !img.complete);
    let left = pending.length;
    for (const img of pending) {
      const done = () => {
        if (--left === 0) measure();
      };
      img.addEventListener("load", done, { once: true });
      img.addEventListener("error", done, { once: true });
    }

    const stop = trackProgress(gallery, "pin", (p) =>
      gallery.style.setProperty("--p", p.toFixed(4)),
    );

    return () => {
      stop();
      window.removeEventListener("resize", measure);
    };
  });
</script>
