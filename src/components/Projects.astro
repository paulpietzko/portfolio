---
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";
import ProjectCard from "./ProjectCard.astro";
import fetchProjects from "../utils/FetchProjects";

const projects = await fetchProjects();

// The deck fans open in alternating directions; which way a card leans is a
// function of where it sits, so it is derived here rather than authored.
const tiltFor = (index: number) => (index % 2 === 0 ? 13 : -13);
---

<section class="projects" id="work" data-projects>
  <Container size="xl">
    <SubTitle
      index="01"
      title="Projects I work on"
      text="A product of my own, a CMS used by thousands of sites, and a system for daycares two continents away."
      link="#work"
    />

  </Container>

  <!-- Outside the container on purpose: the deck runs the full screen width -->
  <div class="projects__deck" data-reveal-group="120">
    {
      projects.map((project, i) => (
        <ProjectCard {...project} tilt={tiltFor(i)} index={i} />
      ))
    }
  </div>
</section>

<style>
  .projects {
    padding-block: clamp(4rem, 9vh, 7rem);
    /* Clips the deck's horizontal bleed without cropping the tilted corners */
    overflow-x: clip;
  }

  .projects__deck {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(0.5rem, 2vh, 1.5rem) clamp(1rem, 4vw, 3rem);
  }

  @media (min-width: 768px) {
    .projects__deck {
      flex-direction: row;
      align-items: center;
      gap: clamp(0.5rem, 1vw, 1rem);
      /* Wider than the screen: the outer two cards run off both edges. */
      width: 118vw;
      margin-inline: -9vw;
      margin-top: clamp(2rem, 6vh, 4rem);
    }

    /* The bleed would take the outer cards' labels off-screen with them, so
       their text block is nudged back inward by the same amount. */
    .projects__deck > :global(.project:first-child .project__meta) {
      padding-left: calc(9vw + clamp(1rem, 2vw, 1.75rem));
    }

    .projects__deck > :global(.project:last-child .project__meta) {
      padding-right: calc(9vw + clamp(1rem, 2vw, 1.75rem));
    }

    /* Centre card sits proud of the other two */
    .projects__deck > :global(.project:nth-child(2)) {
      z-index: 2;
      scale: 1.08;
    }
  }
</style>

<script>
  import { register, trackProgress } from "../scripts/motion";

  register(() => {
    const section = document.querySelector<HTMLElement>("[data-projects]");
    if (!section) return;

    // 0 at the edges of the viewport, 1 when the section sits dead centre —
    // the cards fan open on the way in and fold back on the way out.
    return trackProgress(section, "cover", (p) => {
      const settle = 1 - Math.abs(p - 0.5) * 2;
      section.style.setProperty("--settle", Math.max(settle, 0).toFixed(4));
    });
  });
</script>
