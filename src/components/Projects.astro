---
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";
import ProjectCard from "./ProjectCard.astro";
import fetchProjects from "../utils/FetchProjects";

const projects = await fetchProjects();
---

<section class="projects" id="work" data-projects>
  <Container size="xl">
    <SubTitle
      index="01"
      title="Projects I work on"
      text="A product of my own, a CMS used by thousands of sites, and a system for daycares two continents away."
      link="#work"
    />

  </Container>

  <!-- Outside the container on purpose: the deck runs the full screen width -->
  <!-- Every project is rendered; the script shuffles them on load and CSS
       shows only as many as the screen has room for (3, or 5 when very wide). -->
  <div class="projects__deck" data-projects-deck>
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>

<style>
  .projects {
    padding-block: clamp(4rem, 9vh, 7rem);
    /* Clips the deck's horizontal bleed without cropping the tilted corners */
    overflow-x: clip;
  }

  .projects__deck {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(0.5rem, 2vh, 1.5rem) clamp(1rem, 4vw, 3rem);
  }

  /* Tilt alternates by position, so it follows the shuffled order. */
  .projects__deck > :global(.project:nth-child(odd)) {
    --rot: 9deg;
  }

  .projects__deck > :global(.project:nth-child(even)) {
    --rot: -9deg;
  }

  .projects__deck > :global(.project:nth-child(n + 4)) {
    display: none;
  }

  @media (min-width: 768px) {
    .projects__deck {
      flex-direction: row;
      align-items: center;
      gap: 0;
      /* Wider than the screen: the outer two cards run off both edges. */
      width: 118vw;
      margin-inline: -9vw;
      margin-top: clamp(2rem, 6vh, 4rem);
    }

    /* Side cards are partly covered by the raised centre card, so their
       labels are pulled clear of the overlap. */
    .projects__deck > :global(.project:not(:nth-child(2)) .project__meta) {
      padding-inline: calc(8vw + clamp(1rem, 2vw, 1.75rem));
    }

    /* The bleed would take the outer cards' labels off-screen with them, so
       their text block is nudged back inward by the same amount. */
    .projects__deck > :global(.project:first-child .project__meta) {
      padding-left: calc(9vw + clamp(1rem, 2vw, 1.75rem));
    }

    .projects__deck > :global(.project:nth-child(3) .project__meta) {
      padding-right: calc(9vw + clamp(1rem, 2vw, 1.75rem));
    }

    /* Neighbours tuck under each other */
    .projects__deck > :global(.project + .project) {
      margin-left: -4vw;
    }

    /* Centre card sits proud of the other two */
    .projects__deck > :global(.project:nth-child(2)) {
      z-index: 2;
      scale: 1.08;
    }
  }

  /* Big displays have room for five; a MacBook still gets three. */
  @media (min-width: 1920px) {
    .projects__deck > :global(.project:nth-child(n + 4)) {
      display: block;
    }

    .projects__deck > :global(.project:nth-child(n + 6)) {
      display: none;
    }

    .projects__deck > :global(.project:nth-child(2) .project__meta) {
      padding-inline: calc(8vw + clamp(1rem, 2vw, 1.75rem));
    }

    .projects__deck > :global(.project:nth-child(3) .project__meta) {
      padding-inline: clamp(1rem, 2vw, 1.75rem);
    }

    .projects__deck > :global(.project:nth-child(5) .project__meta) {
      padding-right: calc(9vw + clamp(1rem, 2vw, 1.75rem));
    }

    .projects__deck > :global(.project:nth-child(2)) {
      z-index: auto;
      scale: none;
    }

    .projects__deck > :global(.project:nth-child(3)) {
      z-index: 2;
      scale: 1.08;
    }
  }
</style>

<script>
  // Shuffle the deck so each visit shows a different selection.
  const deck = document.querySelector<HTMLElement>("[data-projects-deck]");
  if (deck) {
    const cards = Array.from(deck.children);
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    deck.append(...cards);
  }
</script>
