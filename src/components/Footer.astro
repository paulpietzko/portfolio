---
import Container from "../layouts/Container.astro";

const socials = [
  {
    name: "Twitter",
    href: "https://x.com/paulpietzko",
    label: "Follow Paul Pietzko on X",
    viewBox: "0 0 512 512",
    path: "M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z",
  },
  {
    name: "GitHub",
    href: "https://github.com/paulpietzko",
    label: "Visit Paul Pietzko on GitHub",
    viewBox: "0 0 480 512",
    path: "M186.1 328.7c0 20.9-10.9 55.1-36.7 55.1s-36.7-34.2-36.7-55.1 10.9-55.1 36.7-55.1 36.7 34.2 36.7 55.1zM480 278.2c0 31.9-3.2 65.7-17.5 95-37.9 76.6-142.1 74.8-216.7 74.8-75.8 0-186.2 2.7-225.6-74.8-14.6-29-20.2-63.1-20.2-95 0-41.9 13.9-81.5 41.5-113.6-5.2-15.8-7.7-32.4-7.7-48.8 0-21.5 4.9-32.3 14.6-51.8 45.3 0 74.3 9 108.8 36 29-6.9 58.8-10 88.7-10 27 0 54.2 2.9 80.4 9.2 34-26.7 63-35.2 107.8-35.2 9.8 19.5 14.6 30.3 14.6 51.8 0 16.4-2.6 32.7-7.7 48.2 27.5 32.4 39 72.3 39 114.2zm-64.3 50.5c0-43.9-26.7-82.6-73.5-82.6-18.9 0-37 3.4-56 6-14.9 2.3-29.8 3.2-45.1 3.2-15.2 0-30.1-.9-45.1-3.2-18.7-2.6-37-6-56-6-46.8 0-73.5 38.7-73.5 82.6 0 87.8 80.4 101.3 150.4 101.3h48.2c70.3 0 150.6-13.4 150.6-101.3zm-82.6-55.1c-25.8 0-36.7 34.2-36.7 55.1s10.9 55.1 36.7 55.1 36.7-34.2 36.7-55.1-10.9-55.1-36.7-55.1z",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/paulpietzko/",
    label: "Connect with Paul Pietzko on LinkedIn",
    viewBox: "0 0 448 512",
    path: "M100.3 448H7.4V148.9h92.9zM53.8 108.1C24.1 108.1 0 83.5 0 53.8a53.8 53.8 0 0 1 107.6 0c0 29.7-24.1 54.3-53.8 54.3zM447.9 448h-92.7V302.4c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3V448z",
  },
];

const legal = [
  { label: "Imprint", href: "/imprint" },
  { label: "Terms", href: "/terms" },
  { label: "Privacy", href: "/privacy" },
  { label: "Cookies", href: "/cookies" },
  { label: "References", href: "/references" },
];

// Split per word first, then per letter, so a line can only ever break
// between words — never in the middle of one.
const headline = "let’s connect"
  .split(" ")
  .map((word) => [...word]);
---

<footer class="footer">
  <Container size="xl">
    <h2 class="footer__title mask-line" aria-label="let’s connect" data-fit>
      <span>
        {
          headline.map((word, w) => (
            <>
              <span class="footer__word" aria-hidden="true">
                {word.map((char) => (
                  <span class="footer__char">{char}</span>
                ))}
              </span>
              {w < headline.length - 1 && " "}
            </>
          ))
        }
      </span>
    </h2>

    <div class="footer__body">
      <div>
        <a class="footer__mail" href="mailto:paul.pietzko@icloud.com">
          paul.pietzko@icloud.com
        </a>
        <p class="footer__note">
          Questions, work, or just to say hello — all welcome.
        </p>
      </div>

      <ul class="footer__socials">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  height="20"
                  width="20"
                  viewBox={social.viewBox}
                  aria-hidden="true"
                >
                  <path fill="currentColor" d={social.path} />
                </svg>
                <span>{social.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>

  <div class="footer__rule"></div>

  <Container size="xl">
    <div class="footer__bottom">
      <p>&copy; {new Date().getFullYear()} Paul Pietzko</p>
      <ul class="footer__legal">
        {
          legal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>

<style>
  .footer {
    padding-top: clamp(4rem, 12vh, 8rem);
  }

  /*
   * The headline always spans the container exactly. --fit-size is measured
   * in JS once the webfont has settled; the clamp is the pre-measurement
   * fallback and what no-JS visitors get.
   */
  .footer__title {
    font-family: var(--font-poster);
    font-weight: 400;
    font-size: var(--fit-size, clamp(2.75rem, 13vw, 11rem));
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--fg-1);
    white-space: nowrap;
  }

  .footer__word {
    display: inline-block;
  }

  /* Each letter lifts on its own when you run the cursor across it */
  .footer__char {
    display: inline-block;
    transition:
      translate var(--dur-mid) var(--ease-out-expo),
      color var(--dur-fast) ease;
  }

  .footer__char:hover {
    translate: 0 -0.06em;
    color: var(--color-accent);
  }

  .footer__body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  .footer__mail {
    font-size: clamp(1.05rem, 2.2vw, 1.6rem);
    font-weight: 500;
    color: var(--fg-1);
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--dur-mid) var(--ease-out-expo);
  }

  .footer__mail:hover {
    background-size: 100% 1px;
  }

  .footer__note {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--fg-3);
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .footer__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--fg-2);
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      translate var(--dur-mid) var(--ease-out-expo);
  }

  .footer__socials a:hover {
    color: var(--fg-1);
    border-color: rgb(255 255 255 / 0.35);
    translate: 0 -2px;
  }

  .footer__rule {
    height: 1px;
    margin-top: clamp(3rem, 8vh, 5rem);
    background: var(--hairline);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
    font-size: 0.8125rem;
    color: var(--fg-3);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
  }

  .footer__legal a {
    transition: color var(--dur-fast) ease;
  }

  .footer__legal a:hover {
    color: var(--fg-1);
  }
</style>

<script>
  import { register } from "../scripts/motion";

  register(() => {
    const title = document.querySelector<HTMLElement>("[data-fit]");
    if (!title) return;

    const words = [
      ...title.querySelectorAll<HTMLElement>(".footer__word"),
    ];
    if (!words.length) return;

    /**
     * Measures the words themselves rather than the heading box — the box is
     * `overflow: hidden`, so its scrollWidth collapses to clientWidth as soon
     * as the text fits and the ratio would always come back as 1.
     *
     * Text width scales linearly with font-size, so one probe gives the exact
     * size that fills the container; a second pass mops up rounding.
     */
    const fit = () => {
      for (let pass = 0; pass < 2; pass++) {
        const probe = pass === 0 ? 100 : parseFloat(title.style.fontSize) || 100;
        title.style.fontSize = `${probe}px`;

        const left = words[0].getBoundingClientRect().left;
        const right = words[words.length - 1].getBoundingClientRect().right;
        const natural = right - left;
        const available = title.clientWidth;
        if (natural <= 0 || available <= 0) return;

        const next = (probe * available) / natural;
        if (!Number.isFinite(next) || next <= 0) return;
        title.style.fontSize = `${next}px`;
      }
    };

    fit();
    // The webfont changes the metrics, so measure again once it has loaded
    document.fonts?.ready.then(fit);

    let frame = 0;
    const onResize = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        fit();
      });
    };
    window.addEventListener("resize", onResize);

    return () => {
      window.removeEventListener("resize", onResize);
      cancelAnimationFrame(frame);
    };
  });
</script>
