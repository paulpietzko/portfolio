---
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";
import fetchStats from "../utils/FetchGitHubStats";
import CommitChart from "./CommitChart.astro";
import fetchUserCommits from "../utils/FetchYearlyCommits";

const stats = await fetchStats("paulpietzko");
const commitsLastYear = await fetchUserCommits("paulpietzko");
const hasCommits = commitsLastYear.some((n) => n > 0);

const tiles = stats
  ? [
      { label: "Commits", value: stats.totalCommits },
      { label: "Reviews", value: stats.totalReviews },
      { label: "Issues", value: stats.totalIssues },
      { label: "Pull requests", value: stats.totalPRs },
      { label: "Repos contributed to", value: stats.contributedTo },
    ]
  : [];
---

{
  (tiles.length > 0 || hasCommits) && (
    <section class="stats" id="stats">
      <Container size="xl">
        <SubTitle
          index="08"
          title="Receipts"
          text="Pulled live from the GitHub API, because a portfolio should be able to show its working."
          link="#stats"
        />

        {tiles.length > 0 && (
          <div class="stats__grid" data-reveal-group="80">
            {tiles.map((tile) => (
              <div class="stat" data-reveal="up">
                <p class="counter" data-count-to={tile.value}>0</p>
                <p class="stat__label eyebrow">{tile.label}</p>
              </div>
            ))}
          </div>
        )}

        {hasCommits && (
          <div class="stats__chart" data-reveal="up">
            <div class="stats__chart-head">
              <h3>Contributions, last 12 months</h3>
              <span class="eyebrow">GitHub</span>
            </div>
            <CommitChart data={commitsLastYear} />
          </div>
        )}
      </Container>
    </section>
  )
}

<style>
  .stats {
    padding-block: clamp(4rem, 9vh, 7rem);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    overflow: hidden;
  }

  .stat {
    padding: clamp(1.5rem, 3vw, 2.5rem) 1.25rem;
    background: var(--color-dark-100);
    text-align: center;
    transition: background-color var(--dur-mid) var(--ease-out-quart);
  }

  .stat:hover {
    background: var(--color-dark-200);
  }

  .stat :global(.counter) {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-accent-soft);
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    margin-top: 0.85rem;
    color: var(--fg-3);
  }

  .stats__chart {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: var(--color-dark-200);
  }

  .stats__chart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stats__chart-head h3 {
    font-size: 1rem;
    font-weight: 500;
    color: var(--fg-1);
  }

  .stats__chart-head .eyebrow {
    color: var(--fg-3);
  }
</style>
