---
import Container from "../layouts/Container.astro";
import SubTitle from "./SubTitle.astro";
import fetchStats from "../utils/FetchGitHubStats";
import CommitChart from "./CommitChart.astro";
import fetchUserCommits from "../utils/FetchYearlyCommits";

const stats = await fetchStats("paulpietzko");
const commitsLastYear = await fetchUserCommits("paulpietzko");
const hasCommits = commitsLastYear.some((n) => n > 0);

const tiles = stats
  ? [
      { label: "Commits", value: stats.totalCommits },
      { label: "Reviews", value: stats.totalReviews },
      { label: "Issues", value: stats.totalIssues },
      { label: "Pull requests", value: stats.totalPRs },
      { label: "Repos contributed to", value: stats.contributedTo },
    ]
  : [];
---

{
  (tiles.length > 0 || hasCommits) && (
    <section class:list={["stats", { "has-ridge": hasCommits }]} id="stats">
      {hasCommits && (
        <div class="stats__ridge" data-reveal>
          <CommitChart data={commitsLastYear} />
        </div>
      )}

      <Container size="xl">
        <SubTitle
          index="07"
          title="Receipts"
          text="Pulled live from the GitHub API, because a portfolio should be able to show its working."
          link="#stats"
        />

        {tiles.length > 0 && (
          <div class="stats__grid" data-reveal-group="80">
            {tiles.map((tile) => (
              <div class="stat" data-reveal="up">
                <p class="counter" data-count-to={tile.value}>0</p>
                <p class="stat__label eyebrow">{tile.label}</p>
              </div>
            ))}
          </div>
        )}

        {hasCommits && (
          <p class="stats__caption eyebrow">Contributions · last 12 months</p>
        )}
      </Container>
    </section>
  )
}

<style>
  .stats {
    position: relative;
    padding-block: clamp(4rem, 9vh, 7rem);
    /* The ridge runs edge to edge; nothing should scroll sideways for it */
    overflow: clip;
  }

  /* Room under the tiles for the year to rise into */
  .stats.has-ridge {
    padding-bottom: clamp(16rem, 34vw, 26rem);
  }

  .stats__ridge {
    position: absolute;
    inset: auto 0 0 0;
    height: clamp(20rem, 46vw, 36rem);
    pointer-events: none;
    /* Fades into the page at the top and both sides */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 6%, #000 94%, transparent),
      linear-gradient(to bottom, transparent, #000 35%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 6%, #000 94%, transparent),
      linear-gradient(to bottom, transparent, #000 35%);
    mask-composite: intersect;
  }

  .stats :global(.container),
  .stats > :global(*:not(.stats__ridge)) {
    position: relative;
    z-index: 1;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    overflow: hidden;
    /* Frosted, so the ridge behind still reads through the tiles */
    background: color-mix(in oklab, var(--color-dark-100) 72%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .stat {
    padding: clamp(1.5rem, 3vw, 2.5rem) 1.25rem;
    /* Hairline dividers without the gap trick, which needs an opaque fill */
    box-shadow: 0 0 0 0.5px var(--hairline);
    text-align: center;
    transition: background-color var(--dur-mid) var(--ease-out-quart);
  }

  .stat:hover {
    background: rgb(255 255 255 / 0.03);
  }

  .stat :global(.counter) {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-accent-soft);
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    margin-top: 0.85rem;
    color: var(--fg-3);
  }

  .stats__caption {
    margin-top: 1.25rem;
    color: var(--fg-3);
  }
</style>
