# Sanity — public project identifiers, also required on the Vercel project.
# The home page is cached by Vercel ISR and regenerated hourly, or right away
# when the Sanity publish webhook revalidates it (see ISR_BYPASS_TOKEN).
PUBLIC_SANITY_PROJECT_ID=jzcwxf3j
PUBLIC_SANITY_DATASET=production

# GitHub personal access token (read-only) for the stats and commit chart.
GITHUB_TOKEN=

# Secret for on-demand ISR revalidation (at least 32 characters), set on the
# Vercel project. Generate one with `openssl rand -hex 32`. The Sanity webhook
# sends it as the `x-prerender-revalidate` header. Not needed locally.
ISR_BYPASS_TOKEN=

# Mapbox public token (pk.…) for the travel globe. Restrict it to your domains
# (paulpietzko.com, localhost) in the Mapbox dashboard. Without it the section
# falls back to the static SVG map.
PUBLIC_MAPBOX_TOKEN=
